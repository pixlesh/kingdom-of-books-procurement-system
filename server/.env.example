# انسخ هذا الملف إلى .env وعبّي القيم الحقيقية محلياً — .env نفسه لا يُرفع لأي مستودع

PORT=3001

# CORS: عنوان الفرونت-إند المسموح له بالاتصال بالباك-إند (Vite dev server افتراضياً)
CLIENT_ORIGIN=http://localhost:5173

# مفاتيح API الخارجية — تعيش هنا فقط، لا تصل أبداً لكود العميل (React)
GOOGLE_BOOKS_API_KEY=

# مفتاح تقييم ISBNdb (المرحلة 3 — تقييم فقط، ليس بخط البحث الإنتاجي).
# اشتراك مدفوع مع تجربة مجانية 7 أيام: https://isbndb.com/isbn-database
# يُستخدم حصراً من: npm run evaluate:isbndb
ISBNDB_API_KEY=

# Open Library ما يحتاج مفتاح — موجود هنا فقط للتوثيق/الاكتمال

# مصادر الناشرين الحية (عصير الكتب/مركز الأدب العربي/دار الشروق) —
# مفتاح إيقاف فوري بلا إعادة نشر؛ أي قيمة غير "off" (أو الغياب) تعني التفعيل
PUBLISHER_LIVE_SOURCES=on

# القاعدة التي تُبنى عليها روابط الأغلفة المخزَّنة عند npm run covers:ingest
# (مثال إنتاج: https://kingdom-of-books-api.onrender.com) — افتراضياً
# http://localhost:${PORT} محلياً؛ لا تُستخدم وقت التشغيل العادي، فقط وقت
# الاستيعاب/إعادة الاستيعاب
COVER_SERVE_BASE=
